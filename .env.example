# GHOST//ROOT — environment template
# =============================================================================
# Copy to `.env` (gitignored) OR provide these as real environment variables on
# the server. NEVER commit real values. NEVER expose any of these to the browser,
# to WordPress option storage, to JS bundles, HTML, screenshots, or logs.
#
# The OpenSea toolkit (opensea/) also reads .secrets/opensea.env; a per-tool
# opensea/.env overrides that. This file is the canonical reference.
# =============================================================================

# --- OpenSea API (server-side only) -----------------------------------------
# Public reads + collection metadata PATCH. Sent as the `x-api-key` header.
OPENSEA_API_KEY=
# ISO-8601 expiry of the key above — the ONLY thing about the key that may be
# recorded in config. Instant free-tier keys expire; the health check warns
# when < 7 days remain. Leave blank for a portal-issued (non-expiring) key.
OPENSEA_API_KEY_EXPIRES_AT=
# Personal Access Token from an interactive SIWX session on opensea.io. Needed
# ONLY for wallet-scoped writes (creator profile, collection "about" page).
# Exchanged for a short-lived wallet JWT at call time — never sent directly.
OPENSEA_SCOPED_TOKEN=

# --- OpenSea target -------------------------------------------------------
OPENSEA_CHAIN=solana
OPENSEA_ENV=production
# Discovered + verified by `npm run opensea:verify`, then copied here. Never
# guessed. Blank until the Solana collection is deployed and OpenSea has
# indexed it and the identity check returns VERIFIED.
OPENSEA_COLLECTION_SLUG=
OPENSEA_COLLECTION_ID=

# --- Authoritative Solana / Metaplex Core collection --------------------
# The verification anchor. Copy from the deployment receipt; never type a
# production address from memory. All blank => OPENSEA_STATUS is
# AWAITING_SOLANA_COLLECTION_DEPLOYMENT and the integration runs inert.
SOLANA_COLLECTION_ADDRESS=
CANDY_MACHINE_ADDRESS=
SOLANA_UPDATE_AUTHORITY=
SOLANA_TREASURY=
METADATA_ROOT=
ARTWORK_ROOT=
DEPLOYMENT_HASH=

# --- Collection facts (used for identity verification; do not invent) ---
COLLECTION_NAME=GHOST//ROOT
COLLECTION_SUPPLY=3333
PROJECT_URL=https://ghostroot.site
# Royalty is authoritative ON-CHAIN (Metaplex Core). This value is only used to
# cross-check what OpenSea displays. Target: 5% = 500 bps.
ROYALTY_BPS=500

# --- OpenSea cache TTLs (seconds) — tune to live rate limits -----------
OPENSEA_CACHE_TTL_COLLECTION=3600
OPENSEA_CACHE_TTL_STATS=300
OPENSEA_CACHE_TTL_FLOOR=120
OPENSEA_CACHE_TTL_ACTIVITY=60
OPENSEA_CACHE_TTL_TRAITS=21600
OPENSEA_CACHE_TTL_VERIFICATION=86400

# --- OpenSea client behaviour -----------------------------------------
OPENSEA_TIMEOUT_MS=20000
OPENSEA_MAX_RETRIES=4
OPENSEA_LOG_LEVEL=info

# =============================================================================
# WordPress side (ghost-root-core plugin)
# -----------------------------------------------------------------------------
# The plugin reads the OpenSea key from a wp-config.php constant OR a server
# environment variable — NEVER from the WordPress database. Preferred:
#
#   // wp-config.php
#   define( 'GHOST_ROOT_OPENSEA_API_KEY', 'xxxxxxxx' );
#   // optional: define( 'GHOST_ROOT_OPENSEA_SLUG', 'ghost-root-solana' );
#   // optional: define( 'GHOST_ROOT_OPENSEA_TESTNET', true );
#
# Or set OPENSEA_API_KEY in the PHP-FPM / server environment.
# The verified collection slug is also settable in wp-admin:
#   GHOST//ROOT → System → "OpenSea collection slug" (only after VERIFIED).
# =============================================================================
