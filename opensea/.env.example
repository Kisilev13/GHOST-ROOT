# GHOST//ROOT — OpenSea integration (server-side only)
# -----------------------------------------------------------------------------
# Copy to .env and fill in. NEVER commit .env. NEVER expose these to the browser,
# WordPress option storage, JS bundles, HTML, screenshots or logs.
# The toolkit also reads /home/hacker/NFT/Ghost/.secrets/opensea.env if present
# (that file already holds the live key for this project); .env overrides it.
# -----------------------------------------------------------------------------

# --- OpenSea API credentials -------------------------------------------------
# Public read + (optionally) collection metadata PATCH. Header: x-api-key
OPENSEA_API_KEY=
# Instant free-tier keys expire. Record the ISO-8601 expiry (NOT the key) so the
# health check can warn before it lapses. Leave blank for a portal-issued key.
OPENSEA_API_KEY_EXPIRES_AT=
# Longer-lived scoped Personal Access Token (SIWX). Only needed for wallet-scoped
# mutations (profile / collection about-page). Exchanged for a short-lived wallet
# JWT at call time — never sent directly in Authorization. Leave blank otherwise.
OPENSEA_SCOPED_TOKEN=

# --- OpenSea target --------------------------------------------------------
OPENSEA_CHAIN=solana
OPENSEA_ENV=production
# Discovered, never guessed. opensea:discover / opensea:verify fill these in a
# report; you copy the verified values here. Blank until the Solana collection
# is deployed AND verified on OpenSea.
OPENSEA_COLLECTION_SLUG=
OPENSEA_COLLECTION_ID=

# --- Authoritative Solana / Metaplex Core collection ----------------------
# Source of truth for identity verification. Copy from the deployment receipt,
# never type a production address from memory.
SOLANA_COLLECTION_ADDRESS=
CANDY_MACHINE_ADDRESS=
SOLANA_UPDATE_AUTHORITY=
SOLANA_TREASURY=
METADATA_ROOT=
ARTWORK_ROOT=
DEPLOYMENT_HASH=

# --- Collection facts used for verification (do not invent) --------------
COLLECTION_NAME=GHOST//ROOT
COLLECTION_SUPPLY=3333
PROJECT_URL=https://ghostroot.site
ROYALTY_BPS=500

# --- Cache TTLs (seconds) — tune to live rate limits --------------------
OPENSEA_CACHE_DIR=.cache
OPENSEA_CACHE_TTL_COLLECTION=3600
OPENSEA_CACHE_TTL_STATS=300
OPENSEA_CACHE_TTL_FLOOR=120
OPENSEA_CACHE_TTL_ACTIVITY=60
OPENSEA_CACHE_TTL_TRAITS=21600
OPENSEA_CACHE_TTL_VERIFICATION=86400

# --- Client behaviour --------------------------------------------------
OPENSEA_TIMEOUT_MS=20000
OPENSEA_MAX_RETRIES=4
OPENSEA_LOG_LEVEL=info
