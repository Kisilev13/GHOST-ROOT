{
  "name": "ghostroot-opensea",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "GHOST//ROOT — server-side OpenSea API v2 integration toolkit (Solana / Metaplex Core secondary market). No runtime dependencies.",
  "engines": { "node": ">=22.6" },
  "scripts": {
    "opensea:bootstrap": "node --experimental-strip-types scripts/opensea-bootstrap.ts",
    "opensea:discover": "node --experimental-strip-types scripts/opensea-discover.ts",
    "opensea:verify": "node --experimental-strip-types scripts/opensea-verify.ts",
    "opensea:profile-sync": "node --experimental-strip-types scripts/opensea-profile-sync.ts",
    "opensea:collection-sync": "node --experimental-strip-types scripts/opensea-collection-sync.ts",
    "opensea:health": "node --experimental-strip-types scripts/opensea-healthcheck.ts",
    "test": "node --experimental-strip-types --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  }
}
