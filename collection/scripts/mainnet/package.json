{
  "name": "ghost-root-mainnet-canary",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Guarded ONE-collection + ONE-canary Metaplex Core mainnet deploy. Never devnet. Never bulk.",
  "scripts": {
    "quote": "tsx upload_mainnet_canary.ts --quote-only",
    "upload": "tsx upload_mainnet_canary.ts",
    "deploy": "tsx deploy_mainnet_canary.ts",
    "verify": "tsx verify_mainnet_canary.ts",
    "test:idempotency": "tsx test_idempotency.ts",
    "test:launch": "node --require ./offline_guard.cjs --import tsx test_launch.ts",
    "test:pda": "node --require ./offline_guard.cjs --import tsx test_pda.ts",
    "launch:allowlist": "tsx allowlist_cli.ts",
    "launch:economics": "tsx build_economics_report.ts",
    "launch:prepare": "tsx deploy_candy_machine.ts",
    "launch:dry-run": "node --require ./offline_guard.cjs --import tsx launch_dry_run.ts"
  },
  "license": "UNLICENSED",
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
