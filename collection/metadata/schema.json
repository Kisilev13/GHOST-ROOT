{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "GHOST//ROOT ERC-721 metadata",
  "description": "Structural schema; CID decoding, asset resolution, per-ID truth and cross-state checks are separate production gates.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "token_id",
    "name",
    "description",
    "image",
    "collection",
    "attributes"
  ],
  "properties": {
    "token_id": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3333
    },
    "name": {
      "type": "string",
      "pattern": "^GHOST//[0-9]{4}$"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 3000
    },
    "image": {
      "type": "string",
      "pattern": "^ipfs://[A-Za-z0-9]+/[0-3]/[1-9][0-9]{0,3}\\.png$"
    },
    "external_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "collection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "symbol"
      ],
      "properties": {
        "name": {
          "const": "GHOST//ROOT"
        },
        "symbol": {
          "const": "GHRT"
        }
      }
    },
    "attributes": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Entity"
              },
              "value": {
                "enum": [
                  "HUMAN",
                  "SYNTHETIC",
                  "HOLLOW",
                  "SPECTER"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Access"
              },
              "value": {
                "enum": [
                  "USER",
                  "ADMIN",
                  "SYSTEM",
                  "ROOT"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Architecture"
              },
              "value": {
                "enum": [
                  "SEALED",
                  "INSET",
                  "DOUBLE PLANE",
                  "SUSPENDED CORE",
                  "SEVERED HALO",
                  "SINGULAR"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Face Material"
              },
              "value": {
                "enum": [
                  "BIO-SYNTH",
                  "PORCELAIN",
                  "CARBON",
                  "CERAMIC",
                  "RECONSTRUCTED",
                  "PHASE GLASS"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Eyes"
              },
              "value": {
                "enum": [
                  "BIOMETRIC",
                  "VOID",
                  "THERMAL",
                  "FRACTURED",
