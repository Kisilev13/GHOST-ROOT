        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trait_type"
            ],
            "properties": {
              "trait_type": {
                "const": "Interface"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trait_type"
            ],
            "properties": {
              "trait_type": {
                "const": "Implant"
              }
            }
          },
          "minContains": 1,
          "maxContains": 1
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "trait_type"
            ],
            "properties": {
