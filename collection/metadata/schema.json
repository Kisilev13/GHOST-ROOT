                  "UNCLOCKED"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Origin Corruption"
              },
              "value": {
                "enum": [
                  "INTACT",
                  "SCAN SHEAR",
                  "CHECKSUM BURN",
                  "PACKET GHOSTING",
                  "MEMORY BLEED",
                  "ABSENCE"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "State"
              },
              "value": {
