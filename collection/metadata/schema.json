                  "COLD STORAGE",
                  "RACK SHADOW",
                  "RELAY WELL",
                  "SERVICE TUNNEL",
                  "ANECHOIC ROOM",
                  "UPLINK BLACK"
                ]
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
