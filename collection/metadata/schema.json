          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "trait_type",
              "value"
            ],
            "properties": {
              "trait_type": {
                "const": "Implant"
              },
              "value": {
                "enum": [
                  "NONE",
                  "NEURAL CABLE",
                  "SPINAL BUS",
                  "ANTENNA",
                  "ROOT PORT",
                  "MEMORY SPINDLE",
